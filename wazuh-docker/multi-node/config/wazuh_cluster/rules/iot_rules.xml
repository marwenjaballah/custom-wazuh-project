<!-- Custom Rules for IIoT Protocols (Objective 7.2) -->
<group name="iot,protocol,">
  <!-- MQTT Rules -->
  <rule id="100100" level="3">
    <decoded_as>iot-mqtt</decoded_as>
    <description>IoT: MQTT publish event detected.</description>
  </rule>

  <rule id="100101" level="12">
    <if_sid>100100</if_sid>
    <field name="iot_topic">^factory/system/admin</field>
    <description>IoT: HIGH RISK - Unauthorized MQTT publish to admin topic.</description>
    <group>unauthorized_access,threat,</group>
  </rule>

  <!-- Modbus Rules -->
  <rule id="100200" level="3">
    <decoded_as>iot-modbus</decoded_as>
    <description>IoT: Modbus command detected.</description>
  </rule>

  <rule id="100201" level="14">
    <if_sid>100200</if_sid>
    <field name="iot_func">^5$|^6$|^15$|^16$</field>
    <description>IoT: CRITICAL - Sensitive Modbus Write Command executed on industrial agent.</description>
    <group>industrial_sabotage,attack,</group>
  </rule>

  <!-- CoAP Rules -->
  <rule id="100300" level="3">
    <decoded_as>iot-coap</decoded_as>
    <description>IoT: CoAP request detected.</description>
  </rule>

  <rule id="100301" level="10">
    <if_sid>100300</if_sid>
    <field name="iot_method">^PUT$|^POST$|^DELETE$</field>
    <description>IoT: MEDIUM RISK - CoAP State Mutation Request (PUT/POST/DELETE).</description>
  </rule>
</group>
